{{!
    @template qtype_questionpy/package/package_missing_from_server

    Represents an error message indicating that a QuestionPy package is not available on the application server.

    In contrast to the `qtype_questionpy/package/package_missing_from_server`-template, this alert is displayed along
    with the `qtype_questionpy/package/package_selection`-template as the required data for the template is still
    available in the database.

    Example context (json):
    {}
}}
<div class="alert alert-danger" role="alert">
    <h4>{{#str}} selection_package_not_usable, qtype_questionpy {{/str}}</h4>
    <p class="mb-0">{{#str}} selection_package_cannot_be_used, qtype_questionpy {{/str}}</p>
    <p>{{#str}} selection_package_list_outdated, qtype_questionpy {{/str}}</p>
    <hr>
    <p class="mb-0"><strong>{{#str}} selection_questions_with_package_unusable, qtype_questionpy {{/str}}</strong></p>
</div>
