{{!
    @template qtype_questionpy/package/package_missing_from_db_and_server

    Represents an error message indicating that a QuestionPy package is not available in the database and on the
    application server.

    This alert is displayed instead of the `qtype_questionpy/package/package_selection`-template, which is why we
    require the identifier and hash of the package. Those attributes are stored in the `qtype_questionpy`-table and are
    available even when the package is removed from the database.

    Context variables required for this template:
    * identifier - QuestionyPy package identifier,
    * hash - QuestionPy package hash,

    Example context (json):
    {
        "identifier": "@local/package",
        "hash": "example_hash"
    }
}}
<div class="alert alert-danger" role="alert">
    <h4>{{#str}} selection_package_not_available, qtype_questionpy {{/str}}</h4>
    <p>{{#str}} selection_package_cannot_be_used, qtype_questionpy {{/str}}</p>
    <hr>
    <p class="mb-0"><strong>{{#str}} selection_questions_with_package_unusable, qtype_questionpy {{/str}}</strong></p>
    <ul>
        <li>{{#str}} package_identifier, qtype_questionpy {{/str}}: {{identifier}}</li>
        <li>{{#str}} package_hash, qtype_questionpy {{/str}}: {{hash}}</li>
    </ul>
    <hr>
    <button class="btn btn-primary" id="qpy-alert-change-package-{{uniqid}}">{{#str}} change_package, qtype_questionpy {{/str}}</button>
</div>
{{#js}}
    require(['qtype_questionpy/edit_question'], function(module) {
        const button = document.getElementById("qpy-alert-change-package-{{uniqid}}");
        module.initChangePackageButton(button);
    });
{{/js}}
