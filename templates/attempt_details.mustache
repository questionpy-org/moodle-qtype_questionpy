{{!
    @template qtype_questionpy/attempt_details

    The main content of the QuestionPy attempt details page.

    Context variables required for this template:
    * disable_pretty_url - URL disabling pretty-printed JSON if it is currently enabled
    * enable_pretty_url - URL enabling  pretty-printed JSON if it is currently disabled
    * attempt_html - Optional: Rendered attempt
    * question_state - The QuestionPy question state
    * attempt_state - The QuestionPy attempt state
    * steps - Array of objects, each of which includes:
      * index - Step index, starting at 0
      * time - User-readable step creation date + time
      * state - The stringified Moodle question_state
      * mark - Formatted mark at the step, or null if none
      * response - The response submitted at this step, if any
      * scoring_state - The scoring state at this step

    Example context (json):
    {
        "disable_pretty_url": "http://localhost:8000/question/type/questionpy/attemptdetails.php?attemptid=78&nopretty=1",
        "enable_pretty_url": null,
        "attempt_html": "<div>...</div>",
        "question_state": "{ \"package_name\": \"local.minimal_example\", \"package_version\": \"0.1.0\" }",
        "attempt_state": "{ \"variant\": 1 }",
        "steps": [{
          "index": 0,
          "time": "28/04/25, 16:26:35",
          "state": "Not yet answered",
          "mark": "1.00",
          "scoring_state": "{ \"key\": \"value\" }",
          "scoring_state": "{ \"key\": \"value\" }"
        }]
    }
}}
<div>
    {{#attempt_html}}
        <section>
            <h3>{{#str}} attempt_preview, qtype_questionpy {{/str}}</h3>
            {{{.}}}
        </section>
    {{/attempt_html}}
    <div class="qpy-state-container">
        <section>
            <h3>{{#str}} question_state, qtype_questionpy {{/str}}</h3>
            <div class="qpy-state-view">
                <div class="clearfix">
                    {{#disable_pretty_url}}
                        <a href="{{{.}}}">{{#str}} disable_json_formatting, qtype_questionpy {{/str}}</a>
                    {{/disable_pretty_url}}
                    {{#enable_pretty_url}}
                        <a href="{{{.}}}">{{#str}} enable_json_formatting, qtype_questionpy {{/str}}</a>
                    {{/enable_pretty_url}}
                    <pre class="pre-scrollable"><code>{{ question_state }}</code></pre>
                </div>
            </div>
        </section>
        <section>
            <h3>{{#str}} attempt_state_qpy, qtype_questionpy {{/str}}</h3>
            <div class="qpy-state-view">
                <div class="clearfix">
                    {{#disable_pretty_url}}
                        <a href="{{{.}}}">{{#str}} disable_json_formatting, qtype_questionpy {{/str}}</a>
                    {{/disable_pretty_url}}
                    {{#enable_pretty_url}}
                        <a href="{{{.}}}">{{#str}} enable_json_formatting, qtype_questionpy {{/str}}</a>
                    {{/enable_pretty_url}}
                    <pre class="pre-scrollable"><code>{{ attempt_state }}</code></pre>
                </div>
            </div>
        </section>
    </div>
    <section>
        <h3>{{#str}} attempt_steps, qtype_questionpy {{/str}}</h3>
        <table class="table qpy-steps-table">
            <colgroup span="4">
            <colgroup span="2">
            <thead>
            <tr>
                <th scope="col">{{#str}} attempt_step_no, qtype_questionpy {{/str}}</th>
                <th scope="col">{{#str}} timecreated {{/str}}</th>
                <th scope="col">{{#str}} attempt_state_moodle, qtype_questionpy {{/str}}</th>
                <th scope="col">{{#str}} mark, qtype_questionpy {{/str}}</th>
                <th scope="col">{{#str}} response, qtype_questionpy {{/str}}</th>
                <th scope="col">{{#str}} scoring_state, qtype_questionpy {{/str}}</th>
            </tr>
            </thead>
            <tbody>
            {{#steps}}
                <tr>
                    <th scope="row">{{ index }}</th>
                    <td>{{ time }}</td>
                    <td>{{{ state }}}</td>
                    <td>
                        {{mark}}
                        {{^mark}}<em>{{#str}} none {{/str}}</em>{{/mark}}
                    </td>
                    <td>
                        {{#response}}
                            <div class="qpy-state-view">
                                <div class="clearfix">
                                    {{#disable_pretty_url}}
                                        <a href="{{{.}}}">{{#str}}
                                            disable_json_formatting, qtype_questionpy {{/str}}</a>
                                    {{/disable_pretty_url}}
                                    {{#enable_pretty_url}}
                                        <a href="{{{.}}}">{{#str}} enable_json_formatting, qtype_questionpy {{/str}}</a>
                                    {{/enable_pretty_url}}
                                    <pre class="pre-scrollable"><code>{{.}}</code></pre>
                                </div>
                            </div>
                        {{/response}}
                        {{^response}}
                            <em>{{#str}} none {{/str}}</em>
                        {{/response}}
                    </td>
                    <td>
                        {{#scoring_state}}
                            <div class="qpy-state-view">
                                <div class="clearfix">
                                    {{#disable_pretty_url}}
                                        <a href="{{{.}}}">{{#str}}
                                            disable_json_formatting, qtype_questionpy {{/str}}</a>
                                    {{/disable_pretty_url}}
                                    {{#enable_pretty_url}}
                                        <a href="{{{.}}}">{{#str}} enable_json_formatting, qtype_questionpy {{/str}}</a>
                                    {{/enable_pretty_url}}
                                    <pre class="pre-scrollable"><code>{{.}}</code></pre>
                                </div>
                            </div>
                        {{/scoring_state}}
                        {{^scoring_state}}
                            <em>{{#str}} none {{/str}}</em>
                        {{/scoring_state}}
                    </td>
                </tr>
            {{/steps}}
            </tbody>
        </table>
    </section>
</div>
